# 数据库配置
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=flask_chat

# 嵌入模型配置（Ollama本地）
EMBED_PROVIDER=ollama
EMBED_MODEL=qwen3-embedding:8b
EMBED_DIM=4096
EMBED_API_BASE=http://localhost:11434/v1
EMBED_API_KEY=ollama

# 大模型配置（支持任意OpenAI兼容接口：Ollama/LM Studio/vLLM/DeepSeek/通义千问/GPT等）
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:14b-instruct-q4_K_M
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# 代码索引配置
CODE_REPO_PATH=/Users/marin/PycharmProjects/flask_chat
EXCLUDE_PATTERNS=["**/node_modules/**","**/.git/**","**/venv/**","**/__pycache__/**","**/dist/**","**/build/**","**/*.lock","**/package-lock.json","**/yarn.lock","**/pnpm-lock.yaml","**/*.min.js","**/*.pyc","**/.next/**","**/target/**","**/bin/**","**/obj/**","**/.idea/**","**/.vscode/**","**/migrations/**"]
CHUNK_LINES=40
CHUNK_LINES_OVERLAP=5
TOP_K=8
